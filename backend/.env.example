# Puerto del Servidor Backend
PORT=3001

# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto-supabase.supabase.co
# Se recomienda usar la Service Role Key para operaciones de backend (insert/update en tablas con RLS)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-supabase
SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Configuración de Resend
RESEND_API_KEY=re_tu_api_key_de_resend
# Email emisor verificado en Resend (por defecto onboarding@resend.dev para pruebas)
RESEND_SENDER_EMAIL=onboarding@resend.dev
